{
  "name": "EVEZ Buyer Demo - Webhook Intake Reliability",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "evez-demo/intake",
        "responseMode": "responseNode"
      },
      "id": "intake",
      "name": "Webhook Intake",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const body=$json.body||$json; const required=['customer_id','request']; const missing=required.filter(k=>body[k]===undefined||body[k]===null||body[k]===''); if(missing.length)return [{json:{ok:false,status:'REJECTED',reason:'missing_required_fields',missing}}]; return [{json:{ok:true,status:'VALIDATED',customer_id:String(body.customer_id),request:String(body.request),received_at:new Date().toISOString()}}];"
      },
      "id": "validate",
      "name": "Validate Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json.ok}}",
              "operation": "isTrue"
            }
          ]
        }
      },
      "id": "gate",
      "name": "Validation Gate",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const crypto=require('crypto'); const event={event:'WORKFLOW_ACCEPTED',customer_id:$json.customer_id,request:$json.request,ts:$json.received_at}; const hash=crypto.createHash('sha256').update(JSON.stringify(event)).digest('hex'); return [{json:{...event,proof_hash:hash}}];"
      },
      "id": "proof",
      "name": "Create Proof Record",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        -80
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ {ok:true,status:'ACCEPTED',customer_id:$json.customer_id,proof_hash:$json.proof_hash} }}"
      },
      "id": "respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        960,
        -80
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ {ok:false,status:'REJECTED',reason:$json.reason,missing:$json.missing} }}"
      },
      "id": "reject",
      "name": "Reject Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        720,
        160
      ]
    }
  ],
  "connections": {
    "Webhook Intake": {
      "main": [
        [
          {
            "node": "Validate Input",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Input": {
      "main": [
        [
          {
            "node": "Validation Gate",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validation Gate": {
      "main": [
        [
          {
            "node": "Create Proof Record",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Reject Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create Proof Record": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}